# Copy to backend/.env (or export in your shell). Never commit real values.

# development | test | staging | production
APP_ENV=development
# PostgreSQL only. Local dev example (role and DB created per backend/README.md):
DATABASE_URL=postgres://halqa:halqa-dev-only@localhost:5432/halqa_dev
# Required in staging/production: a unique random value (>= 50 chars).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_TIMEZONE=Africa/Cairo
FRONTEND_URL=http://localhost:5173
# Native (Android) bearer token lifetime
NATIVE_TOKEN_TTL_DAYS=30
# Email for password recovery. Console backend prints emails to the log (dev only).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@halqa.app
# Optional shared cache for rate limits across processes
REDIS_URL=
LOG_LEVEL=INFO

# Frontend (Vite) — public values only, never secrets.
# Unset/empty → demo mode (no server). "/" → same origin (dev: Vite proxies /api to API_PROXY_TARGET).
# Android builds need the full https:// API origin.
VITE_API_BASE_URL=/
API_PROXY_TARGET=http://localhost:8000

# Private media (recordings). s3 = any S3-compatible bucket (R2 proposed); local = dev only.
MEDIA_STORAGE=local
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MEDIA_URL_TTL_SECONDS=600
